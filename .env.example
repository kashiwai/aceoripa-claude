# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

# OpenAI (Optional - プレースホルダー画像で動作可能)
OPENAI_API_KEY=your_openai_api_key_or_xxx

# GMO FINCODE設定
NEXT_PUBLIC_FINCODE_PUBLIC_KEY=your_fincode_public_key
FINCODE_SECRET_KEY=your_fincode_secret_key
FINCODE_SHOP_ID=your_fincode_shop_id
NEXT_PUBLIC_FINCODE_ENV=test  # 'test' または 'prod'

# アプリケーションURL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web Push Notifications
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key

# Google Service Account (Optional)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account_email
GOOGLE_PRIVATE_KEY=your_private_key

# ソーシャルログイン設定
# LINE Login
LINE_CHANNEL_ID=your_line_channel_id
LINE_CHANNEL_SECRET=your_line_channel_secret

# Google OAuth (Supabaseで設定)
# Twitter/X OAuth (Supabaseで設定)